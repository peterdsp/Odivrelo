# National KTEL database paths on the Raspberry Pi.
# ODIVRELO_KTEL_* is the current name. The legacy SYRMOS_KTEL_* names are still
# read as a fallback so an existing deployment keeps working until it migrates.
ODIVRELO_KTEL_DB_PATH=/home/peterdsp/odivrelo/db/ktel.db
ODIVRELO_KTEL_PUBLIC_DB_PATH=/home/peterdsp/odivrelo/db/ktel-public.db
ODIVRELO_KTEL_MANIFEST_PATH=/home/peterdsp/odivrelo/out/ktel/manifest.json

# TicketWeb live reads stay disabled until terms and reuse permission have
# been reviewed. Do not copy browser credentials into this file or the repo.
KTEL_TICKETWEB_TERMS_APPROVED=0
KTEL_TICKETWEB_API_URL_TEMPLATE=
KTEL_TICKETWEB_AUTHORIZATION=
KTEL_TICKETWEB_CRYPTO_KEY=
KTEL_TICKETWEB_CLIENT_KEY=
KTEL_TICKETWEB_CLIENT_KEY_HEADER=X-Client-Key

# Conservative acquisition limits.
KTEL_TICKETWEB_MAX_REQUESTS_PER_RUN=500
KTEL_TICKETWEB_MIN_INTERVAL_SECONDS=2.0
KTEL_TICKETWEB_JITTER_SECONDS=0.4

# Raw TicketWeb bodies remain memory-only by default. Set this only if the
# legal and retention review explicitly permits a time-bounded disk cache.
KTEL_TICKETWEB_RAW_CACHE_APPROVED=0
KTEL_TICKETWEB_CACHE_DIR=/home/peterdsp/odivrelo/cache/ktel-ticketweb
KTEL_TICKETWEB_CACHE_TTL_SECONDS=21600
