      "comment": "The stored file could not be opened",
      "extractionState": "manual",
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το αρχείο δεν μπόρεσε να ανοίξει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file could not be opened."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ky skedar nuk mund të hapej."
          }
        }
      }
    },
    "wallet.storageExplainer": {
      "comment": "Where a ticket is stored and how",
      "extractionState": "manual",
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα εισιτήρια αποθηκεύονται κρυπτογραφημένα στη συσκευή, εξαιρούνται από τα αντίγραφα ασφαλείας iCloud και iTunes, και διαγράφονται οριστικά όταν τα διαγράψετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tickets are stored encrypted on the device, excluded from iCloud and iTunes backups, and permanently removed when you delete them."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Biletat ruhen të enkriptuara në pajisje, përjashtohen nga rezervimet iCloud dhe iTunes, dhe fshihen përgjithmonë kur i fshini."
          }
        }
      }
    },
