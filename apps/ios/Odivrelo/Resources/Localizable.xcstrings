    "coverage.notCoveredEmpty": {
      "comment": "Shown when the release states nothing about what it does not cover. Must not read as full coverage.",
      "extractionState": "manual",
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η έκδοση δεν δηλώνει τι δεν καλύπτει. Μην το εκλάβετε ως πλήρη κάλυψη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This release states nothing about what it does not cover. Do not read that as full coverage."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ky publikim nuk deklaron çfarë nuk mbulon. Mos e lexoni si mbulim të plotë."
          }
        }
      }
    },
