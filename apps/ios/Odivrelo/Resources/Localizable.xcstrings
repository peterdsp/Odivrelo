    "settings.nameOrigin": {
      "comment": "Honest statement about the invented name. Must not claim it is a Greek word.",
      "extractionState": "manual",
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Odivrelo είναι εφευρημένο όνομα. Δεν είναι ελληνική λέξη και δεν είναι μετάφραση κάποιας λέξης."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Odivrelo is an invented name. It is not a Greek word, and it is not a translation of anything."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Odivrelo është emër i shpikur. Nuk është fjalë greke dhe nuk është përkthim i ndonjë fjale."
          }
        }
      }
    },
