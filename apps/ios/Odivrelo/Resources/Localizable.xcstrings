    "deeplink.expiredBody": {
      "comment": "Body for an expired link. %@ is the service date the link named.",
      "extractionState": "manual",
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτός ο σύνδεσμος αφορά την ημερομηνία %@, που έχει περάσει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That link is for %@, which has passed."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajo lidhje është për %@, e cila ka kaluar."
          }
        }
      }
    },
