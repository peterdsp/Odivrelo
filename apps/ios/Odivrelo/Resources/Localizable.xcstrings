    "settings.privacyBody": {
      "comment": "The complete privacy statement",
      "extractionState": "manual",
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Odivrelo δεν έχει λογαριασμούς, δεν συλλέγει αναλυτικά στοιχεία και δεν περιέχει ιχνηλάτες τρίτων. Οι αναζητήσεις, τα αγαπημένα, τα ταξίδια και τα εισιτήριά σας παραμένουν στη συσκευή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Odivrelo has no accounts, collects no analytics and contains no third-party trackers. Your searches, favourites, trips and tickets stay on the device."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Odivrelo nuk ka llogari, nuk mbledh analitikë dhe nuk përmban gjurmues të palëve të treta. Kërkimet, të preferuarat, udhëtimet dhe biletat tuaja mbeten në pajisje."
          }
        }
      }
    },
    "settings.reduceMotionNote": {
      "comment": "Explains the app already follows the system setting",
      "extractionState": "manual",
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Odivrelo ακολουθεί τη ρύθμιση Μείωση κίνησης της συσκευής."
