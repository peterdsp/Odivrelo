    "reminders.privacyNote": {
      "comment": "States exactly what a reminder payload contains",
      "extractionState": "manual",
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η υπενθύμιση περιέχει μόνο την ώρα και τον τόπο αναχώρησης. Ποτέ όνομα επιβάτη, κωδικό κράτησης, εικόνα εισιτηρίου ή γραμμωτό κώδικα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A reminder carries only the departure time and place. Never a passenger name, booking reference, ticket image or barcode."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Një kujtesë përmban vetëm orën dhe vendin e nisjes. Kurrë emër udhëtari, referencë rezervimi, imazh bilete ose barkod."
          }
        }
      }
    },
