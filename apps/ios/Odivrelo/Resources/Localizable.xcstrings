    "wallet.importExplainer": {
      "comment": "Explains the wallet only ever holds files the person chose",
      "extractionState": "manual",
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Odivrelo αποθηκεύει μόνο αρχεία που επιλέγετε εσείς. Δεν διαβάζει email, δεν στέλνει τίποτα και δεν ανεβάζει ποτέ ένα εισιτήριο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Odivrelo stores only files you choose yourself. It reads no email, sends nothing, and never uploads a ticket."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Odivrelo ruan vetëm skedarë që i zgjidhni vetë. Nuk lexon email, nuk dërgon asgjë dhe nuk ngarkon kurrë një biletë."
          }
        }
      }
    },
    "wallet.importedAt": {
      "comment": "When a ticket was imported. %@ is a date.",
      "extractionState": "manual",
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εισήχθη %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imported %@"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Importuar %@"
          }
        }
      }
    },
