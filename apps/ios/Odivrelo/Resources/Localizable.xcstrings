{
  "sourceLanguage": "el",
  "strings": {
    "a11y.brandMark": {
      "comment": "VoiceOver label for the Odivrelo mark",
      "extractionState": "manual",
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σήμα Odivrelo: κύκλος που τον διασχίζει δρόμος, με πορτοκαλί σημείο προορισμού"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Odivrelo mark: a ring crossed by a road, with an orange destination point"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Shenja Odivrelo: një rreth i përshkuar nga një rrugë, me një pikë portokalli destinacioni"
          }
        }
      }
    },
    "a11y.errorAnnouncement": {
      "comment": "Spoken when an error appears. %@ is the error text.",
      "extractionState": "manual",
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σφάλμα. %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Error. %@"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Gabim. %@"
          }
        }
      }
    },
    "a11y.journeyCard": {
      "comment": "VoiceOver summary of a journey card. %1$@ departure time, %2$@ origin, %3$@ arrival time, %4$@ destination, %5$@ operator.",
      "extractionState": "manual",
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αναχώρηση %1$@ από %2$@, άφιξη %3$@ στον προορισμό %4$@, μεταφορέας %5$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Departs %1$@ from %2$@, arrives %3$@ at %4$@, operated by %5$@"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Niset %1$@ nga %2$@, mbërrin %3$@ në %4$@, operuar nga %5$@"
          }
        }
      }
    },
    "a11y.loadedAnnouncement": {
      "comment": "Spoken when results finish loading. %lld is the number of results.",
      "extractionState": "manual",
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φορτώθηκαν %lld δρομολόγια"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loaded %lld journeys"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "U ngarkuan %lld udhëtime"
          }
        }
      }
    },
    "a11y.mapHint": {
      "comment": "VoiceOver hint telling the reader the stop list, which is above the map on this screen, holds the same facts",
      "extractionState": "manual",
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε πληροφορία του χάρτη υπάρχει και στον κατάλογο στάσεων πιο πάνω."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every fact on the map is also in the stop list above."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Çdo fakt në hartë ndodhet edhe në listën e ndalesave më sipër."
          }
        }
      }
    },
    "a11y.progressPercent": {
      "comment": "VoiceOver value for a download progress bar. %lld is a percentage.",
