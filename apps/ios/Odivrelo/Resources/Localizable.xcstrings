    "settings.diagnosticsNote": {
      "comment": "Explains what diagnostics contain",
      "extractionState": "manual",
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα διαγνωστικά περιέχουν μόνο εκδόσεις, κατάσταση δεδομένων και μεγέθη. Κανένα προσωπικό στοιχείο, κανένα εισιτήριο και κανένα μυστικό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostics carry only versions, data state and sizes. No personal detail, no ticket and no secret."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostika përmban vetëm versione, gjendjen e të dhënave dhe madhësi. Asnjë detaj personal, asnjë biletë dhe asnjë sekret."
          }
        }
      }
    },
