    "error.coreUnavailable": {
      "comment": "The shared data core was not linked into this build. Must not read as a temporary network problem.",
      "extractionState": "manual",
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο κοινός πυρήνας δεδομένων του Odivrelo δεν περιλαμβάνεται σε αυτή την έκδοση της εφαρμογής, οπότε δεν υπάρχουν δεδομένα δρομολογίων. Δεν πρόκειται για πρόβλημα δικτύου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shared Odivrelo data core is not part of this build, so there is no timetable data. This is not a network problem."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Bërthama e përbashkët e të dhënave të Odivrelo nuk është pjesë e këtij ndërtimi, ndaj nuk ka të dhëna orari. Ky nuk është problem rrjeti."
          }
        }
      }
    },
    "error.decoding": {
      "comment": "The answer did not match the published contract",
      "extractionState": "manual",
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η απάντηση δεν ταιριάζει με το δημοσιευμένο συμβόλαιο δεδομένων."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The answer did not match the published data contract."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Përgjigjja nuk përputhej me kontratën e publikuar të të dhënave."
          }
        }
      }
    },
    "error.incompleteData": {
      "comment": "Title when a release is installed but some of its packs are missing",
      "extractionState": "manual",
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα εγκατεστημένα δεδομένα είναι ελλιπή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The installed data is incomplete."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Të dhënat e instaluara janë të paplota."
          }
        }
      }
    },
    "error.incompleteDataHint": {
      "comment": "What to do: finish the install from the Offline screen",
      "extractionState": "manual",
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίξτε τα Εκτός σύνδεσης για να ολοκληρώσετε την εγκατάσταση των πακέτων που λείπουν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Offline to finish installing the packs that are missing."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapni Jashtë linje për të përfunduar instalimin e paketave që mungojnë."
          }
        }
      }
    },
    "error.integrity": {
      "comment": "A downloaded pack failed its SHA-256 check",
      "extractionState": "manual",
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το ληφθέν πακέτο απέτυχε στον έλεγχο ακεραιότητας και δεν εγκαταστάθηκε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The downloaded pack failed its integrity check and was not installed."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Paketa e shkarkuar dështoi kontrollin e integritetit dhe nuk u instalua."
          }
        }
      }
    },
    "error.interrupted": {
      "comment": "The download stopped part way",
      "extractionState": "manual",
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η λήψη διακόπηκε. Μπορείτε να συνεχίσετε από εκεί που σταμάτησε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The download was interrupted. You can resume from where it stopped."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Shkarkimi u ndërpre. Mund ta vazhdoni aty ku ndaloi."
          }
        }
      }
    },
    "error.invalidRequest": {
      "comment": "The request was rejected. %@ names the field.",
      "extractionState": "manual",
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το αίτημα απορρίφθηκε στο πεδίο %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request was rejected on the field %@."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kërkesa u refuzua te fusha %@."
          }
        }
      }
    },
    "error.noDataInstalled": {
      "comment": "Title when the device holds no offline release at all, which is the first screen of a new installation",
      "extractionState": "manual",
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν έχουν εγκατασταθεί ακόμη δεδομένα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No data is installed yet."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ende nuk janë instaluar të dhëna."
          }
        }
      }
    },
    "error.noDataInstalledHint": {
      "comment": "What to do about it: go to the Offline screen and install a release",
      "extractionState": "manual",
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίξτε τα Εκτός σύνδεσης και εγκαταστήστε μια έκδοση δεδομένων. Μετά μπορείτε να αναζητήσετε χωρίς σύνδεση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Offline and install a data release. After that you can search without a connection."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapni Jashtë linje dhe instaloni një version të dhënash. Më pas mund të kërkoni pa lidhje."
          }
        }
      }
    },
    "error.noOfflineDataForDate": {
      "comment": "Title when no timetable pack is held for the requested date. Never says no service runs that date",
      "extractionState": "manual",
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχουν δεδομένα εκτός σύνδεσης για αυτή την ημερομηνία."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No offline data for this date."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuk ka të dhëna jashtë linje për këtë datë."
          }
        }
      }
    },
    "error.noOfflineDataForDateHint": {
      "comment": "Explains that this says nothing about whether service runs, and offers the Offline screen",
      "extractionState": "manual",
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό δεν σημαίνει ότι δεν εκτελείται δρομολόγιο. Η συσκευή απλώς δεν κρατά πρόγραμμα για αυτή την ημερομηνία. Ανοίξτε τα Εκτός σύνδεσης για να κατεβάσετε την ημέρα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This does not mean no service runs. The device simply holds no timetable for this date. Open Offline to download the day."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjo nuk do të thotë se nuk ka shërbim. Pajisja thjesht nuk mban orar për këtë datë. Hapni Jashtë linje për ta shkarkuar ditën."
          }
        }
      }
    },
    "error.notFound": {
