    "error.releaseMismatch": {
      "comment": "Local packs and server answers come from different releases",
      "extractionState": "manual",
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα αποθηκευμένα δεδομένα προέρχονται από άλλη έκδοση από τον διακομιστή. Εμφανίζονται τα αποθηκευμένα δεδομένα και η ηλικία τους."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your stored data comes from a different release than the server. The stored release and its age are shown instead."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Të dhënat tuaja të ruajtura vijnë nga një publikim tjetër nga serveri. Në vend të tyre shfaqet publikimi i ruajtur dhe mosha e tij."
          }
        }
      }
    },
