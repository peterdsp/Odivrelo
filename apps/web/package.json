{
  "name": "odivrelo-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Odivrelo public web application. Static PWA served from GitHub Pages.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build && node scripts/postbuild.mjs && node scripts/prerender.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium firefox webkit",
    "e2e:report": "playwright show-report artifacts/playwright-report",
    "budget": "node scripts/check-budgets.mjs",
    "brand:module": "node scripts/generate-brand-module.mjs",
    "prerender": "node scripts/prerender.mjs"
  },
  "dependencies": {
    "idb": "8.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "axe-core": "4.13.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.5",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "maplibre-gl": "5.24.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "3.2.7",
    "workbox-window": "7.4.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
