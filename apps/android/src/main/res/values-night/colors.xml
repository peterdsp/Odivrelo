<?xml version="1.0" encoding="utf-8"?>
<!--
  Only the colours the platform needs before Compose starts drawing, and the
  two that tint the in-app mark. Generated by scripts/generate-design-tokens.sh
  from design/tokens/odivrelo.tokens.json; every other colour lives in the
  Compose theme, generated from the same file, so there is one palette.
-->
<resources>
    <!-- color.*.background -->
    <color name="odivrelo_window_background">#06131C</color>
    <!-- color.brand.deepTealBlue, the app icon's ground -->
    <color name="odivrelo_splash_background">#0B4A6B</color>
    <!-- the in-app mark: ring and road -->
    <color name="odivrelo_mark_ring">#FFFFFF</color>
    <color name="odivrelo_mark_road">#FFFFFF</color>
</resources>
