<?xml version="1.0" encoding="utf-8"?>
<!--
  The Android 12 and later spelling of the same decision. Cloud backup and
  device-to-device transfer both exclude the travel wallet, the installed data
  packs and the local database. See the comment in backup_rules.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="wallet/" />
        <exclude domain="file" path="packs/" />
        <exclude domain="database" path="poravia.db" />
        <exclude domain="sharedpref" path="poravia_wallet_keys.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="wallet/" />
        <exclude domain="file" path="packs/" />
        <exclude domain="database" path="poravia.db" />
        <exclude domain="sharedpref" path="poravia_wallet_keys.xml" />
    </device-transfer>
</data-extraction-rules>
