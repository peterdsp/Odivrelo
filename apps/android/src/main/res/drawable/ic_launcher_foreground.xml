<?xml version="1.0" encoding="utf-8"?>
<!--
  The Poravia mark, taken from design/logo/poravia-mark.svg so Web, iOS and
  Android ship the same one.

  The mark is a passage: an arch you travel through, in limestone, with the exact
  boarding point marked inside it in sun amber. The source artwork is 64 units
  square; the group below maps it onto 18..90 of the 108 unit viewport, which is
  the adaptive icon's 72 unit safe zone, so nothing is clipped by any mask shape.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="1.125"
        android:scaleY="1.125"
        android:translateX="18"
        android:translateY="18">
        <path
            android:pathData="M16,53V30a16,16 0,0 1,32 0v23"
            android:strokeColor="#EFF7F5"
            android:strokeWidth="7.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:fillColor="#F2B84B"
            android:pathData="M32,28.5a5.5,5.5 0,1 0,0 11a5.5,5.5 0,1 0,0 -11z" />
    </group>
</vector>
