    <string name="privacy_version">Version 1.0.0 · 30 September 2026</string>
    <string name="privacy_contact">Contact: %1$s</string>
    <string name="privacy_short_title">The short version</string>
    <string name="privacy_short_body">Odivrelo has no accounts, no analytics and no third-party trackers. Your searches, saved trips and imported tickets stay on your device. Odivrelo does not sell or issue tickets, and it never sees your booking.</string>
    <string name="privacy_storage_title">What Odivrelo stores, and where</string>
    <string name="privacy_storage_intro">Everything below is stored on your device only.</string>
    <string name="privacy_storage_preferences">Language, theme and accessibility preferences, in the application\'s own preferences. Deleted from Settings, or by uninstalling.</string>
    <string name="privacy_storage_recents">Recent searches, in a local database, so you do not retype them.</string>
    <string name="privacy_storage_saved">Favourites and saved trips, in a local database, so a trip is usable offline. Deleted per item.</string>
    <string name="privacy_storage_packs">Downloaded offline packs, in application storage, so timetables work without a connection. Deleted per pack.</string>
    <string name="privacy_storage_tickets">Imported ticket files, in app-private encrypted storage, so you can show a ticket you already have. Deletion is real.</string>
    <string name="privacy_storage_reminders">Reminder schedules, in the platform notification store, so an opt-in reminder fires. Removed by switching the reminder off.</string>
    <string name="privacy_storage_footer">Nothing in that list is transmitted to Odivrelo or to anyone else. There is no Odivrelo account and no server-side profile of you.</string>
    <string name="privacy_wallet_title">The travel wallet</string>
    <string name="privacy_wallet_body">Ticket files you import are treated as sensitive documents. They are stored in app-private storage, encrypted with a key that cannot leave the device, and excluded from device backup. They are never uploaded, never sent to a notification service, never written to a log, never included in diagnostics and never placed in a shared cache. Barcodes are never logged and never put in a URL. Deleting a ticket deletes the file.</string>
    <string name="privacy_network_title">Network requests Odivrelo makes</string>
    <string name="privacy_network_packs">Release manifest and data packs, to the Odivrelo origin. They contain no personal data.</string>
    <string name="privacy_network_booking">A booking handoff, to the operator\'s own website in a browser tab. Odivrelo adds nothing. From that point the operator\'s own privacy policy applies.</string>
    <string name="privacy_network_maps">Opening a map, in your device\'s own maps application. Odivrelo downloads no map tiles and sends no location.</string>
    <string name="privacy_network_footer">Odivrelo adds no identifier, no advertising id and no fingerprint to any request.</string>
    <string name="privacy_permissions_title">Permissions</string>
    <string name="privacy_permissions_notifications">Notifications, for the reminders you set yourself. If you refuse, reminders are simply unavailable and the application says so.</string>
    <string name="privacy_permissions_files">Choosing a file, only for the ticket you pick yourself. Broad file access is never requested.</string>
    <string name="privacy_permissions_none">Odivrelo requests no location, contacts, calendar, camera, microphone or broad storage access.</string>
    <string name="privacy_notifications_title">Notification content</string>
    <string name="privacy_notifications_body">A reminder contains the journey time and the boarding point only. Never a passenger name, a booking reference, a ticket image or a barcode.</string>
    <string name="privacy_third_parties_title">Third parties</string>
    <string name="privacy_third_parties_body">Odivrelo embeds no analytics, advertising, crash-reporting or social SDK. The complete list of third-party code is the open-source licence list in these settings.</string>
    <string name="privacy_children_title">Children</string>
    <string name="privacy_children_body">Odivrelo is not directed at children and collects nothing from anyone.</string>
    <string name="privacy_service_data_title">Data about coach services</string>
    <string name="privacy_service_data_body">Odivrelo publishes public transport information with its source, retrieval time, rights state and review state attached. That is information about services, not about you. Corrections and takedown requests go to %1$s.</string>
    <string name="privacy_changes_title">Changes</string>
    <string name="privacy_changes_body">Material changes are published here and in the release notes, with a date.</string>
    <string name="support_demo_title">Before anything else: this beta shows invented data</string>
    <string name="support_demo_body">Every journey, terminal, operator and fare in Odivrelo 1.0.0 belongs to a fictional region called Aloria, which does not exist. Do not use this build to plan a trip. The app says so on every screen, and that notice is not a bug.</string>
    <string name="support_questions_title">Common questions</string>
    <string name="support_q_missing">Why can I not find my journey?</string>
    <string name="support_a_missing">Because this beta contains no real Greek coach data. See above.</string>
    <string name="support_q_tickets">Why does Odivrelo not sell tickets?</string>
    <string name="support_a_tickets">It is not a ticket seller and never will be without written authority from an operator. It sends you to the operator\'s own booking page, or to its verified ticket office where there is no online sale.</string>
    <string name="support_q_freshness">What does the freshness label mean?</string>
    <string name="support_a_freshness">When that fact was last checked against its source, and how old that is. Fresh, ageing and stale are thresholds, not guarantees. A stale label means verify before you travel.</string>
    <string name="support_q_map">Why does the map look approximate?</string>
    <string name="support_a_map">Route geometry in this release is ordered-stops-only and is labelled as such. It is not an exact road alignment, and Odivrelo does not pretend otherwise.</string>
    <string name="support_q_live">Where is live coach tracking?</string>
    <string name="support_a_live">Not in this release. There is no authorised live feed, so Odivrelo shows the schedule and says live tracking is unavailable rather than animating a coach that is not there.</string>
    <string name="support_q_pack">My offline pack will not install.</string>
    <string name="support_a_pack">Odivrelo verifies a pack\'s SHA-256 before using it and refuses a corrupt one. Delete it and download again. If it keeps failing, the data release may have been replaced mid-download. Refresh and retry.</string>
    <string name="support_q_delete">Can I get my ticket files back after deleting them?</string>
    <string name="support_a_delete">No. Deletion is real and Odivrelo holds no copy anywhere.</string>
    <string name="support_report_title">Reporting a problem</string>
    <string name="support_report_body">Send to %1$s what you expected and what happened, the platform and version from Settings, which also shows the build commit and the data release id, and the screen plus the journey or operator id if relevant.</string>
    <string name="support_report_warning">Do not send ticket files, booking references or passenger names. They are never needed to diagnose a problem.</string>
    <string name="support_corrections_title">Corrections and takedown</string>
    <string name="support_corrections_body">Every operator, station and journey screen has a correction path. Rights holders can request review or takedown at %1$s.</string>
    <string name="support_accessibility_title">Accessibility</string>
    <string name="support_accessibility_body">Accessibility is a release gate, not a feature request queue. If something is unusable with TalkBack, a keyboard, large text or reduced motion, report it as a defect and it will be treated as one.</string>
