{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poravia.peterdsp.dev/schemas/v1/error-v1.schema.json",
  "title": "Error, version 1",
  "description": "The single error shape returned by every non-2xx response.",
  "type": "object",
  "required": [
    "error"
  ],
  "properties": {
    "error": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "not_found",
            "invalid_request",
            "unavailable",
            "release_mismatch",
            "unauthorized"
          ]
        },
        "message": {
          "type": "string"
        },
        "field": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
