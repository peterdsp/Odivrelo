# Poravia daily source monitor.
PORAVIA_CONTACT_EMAIL=info@peterdsp.dev
PORAVIA_MAX_REQUESTS=100
PORAVIA_MIN_HOST_INTERVAL_SECONDS=1.5
PORAVIA_JITTER_SECONDS=0.3
PORAVIA_TIMEOUT_SECONDS=20

# TicketWeb remains disabled until written terms and reuse permission exist.
PORAVIA_TICKETWEB_TERMS_APPROVED=0

# Runtime paths are outside the repository.
PORAVIA_DATA_ROOT=/home/peterdsp/.local/share/poravia
PORAVIA_REPORT_ROOT=/home/peterdsp/.local/state/poravia/reports
