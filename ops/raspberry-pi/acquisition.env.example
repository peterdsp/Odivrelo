# Odivrelo daily source monitor.
ODIVRELO_CONTACT_EMAIL=info@peterdsp.dev
ODIVRELO_MAX_REQUESTS=100
ODIVRELO_MIN_HOST_INTERVAL_SECONDS=1.5
ODIVRELO_JITTER_SECONDS=0.3
ODIVRELO_TIMEOUT_SECONDS=20

# TicketWeb remains disabled until written terms and reuse permission exist.
ODIVRELO_TICKETWEB_TERMS_APPROVED=0

# Runtime paths are outside the repository.
ODIVRELO_DATA_ROOT=/home/peterdsp/.local/share/odivrelo
ODIVRELO_REPORT_ROOT=/home/peterdsp/.local/state/odivrelo/reports
