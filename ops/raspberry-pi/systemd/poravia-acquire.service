[Unit]
Description=Poravia bounded daily source acquisition
Documentation=https://github.com/peterdsp/Poravia
After=network-online.target
Wants=network-online.target
ConditionPathExists=%h/poravia/data/operators/registry.json

[Service]
Type=oneshot
WorkingDirectory=%h/poravia
EnvironmentFile=-%h/.config/poravia/acquisition.env
ExecStart=%h/poravia/ops/raspberry-pi/run-acquisition.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
NoNewPrivileges=true
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true

[Install]
WantedBy=default.target
