{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Odivrelo",
  "version": "1.0.0",
  "color": {
    "brand": {
      "deepTealBlue": { "$type": "color", "$value": "#0B4A6B" },
      "warmOrange": { "$type": "color", "$value": "#FF9F2E" },
      "lightBackground": { "$type": "color", "$value": "#E6F1F7" },
      "navy": { "$type": "color", "$value": "#082F45" },
      "night": { "$type": "color", "$value": "#06131C" }
    },
    "primitive": {
      "teal950": { "$type": "color", "$value": "#06131C" },
      "teal900": { "$type": "color", "$value": "#082F45" },
      "teal800": { "$type": "color", "$value": "#0C1F2B" },
      "teal700": { "$type": "color", "$value": "#083A55" },
      "teal600": { "$type": "color", "$value": "#0B4A6B" },
      "teal500": { "$type": "color", "$value": "#1A6690" },
      "teal300": { "$type": "color", "$value": "#7CC4E8" },
      "teal200": { "$type": "color", "$value": "#A9D8EF" },
      "teal100": { "$type": "color", "$value": "#D2E7F2" },
      "teal050": { "$type": "color", "$value": "#E6F1F7" },
      "orange500": { "$type": "color", "$value": "#FF9F2E" },
      "orange100": { "$type": "color", "$value": "#FFE9CC" },
      "orangeInk": { "$type": "color", "$value": "#4A2800" },
      "coral700": { "$type": "color", "$value": "#8F2F25" },
      "coral100": { "$type": "color", "$value": "#FCE8E5" },
      "green700": { "$type": "color", "$value": "#185C38" },
      "green100": { "$type": "color", "$value": "#E3F3E9" },
      "blue700": { "$type": "color", "$value": "#174F83" },
      "blue100": { "$type": "color", "$value": "#E5F0FA" },
      "stone700": { "$type": "color", "$value": "#45596A" },
      "stone500": { "$type": "color", "$value": "#687F90" },
      "stone200": { "$type": "color", "$value": "#C9D8E1" },
      "stone100": { "$type": "color", "$value": "#E3ECF1" },
      "canvas": { "$type": "color", "$value": "#F4F8FB" },
      "white": { "$type": "color", "$value": "#FFFFFF" }
    },
    "light": {
      "background": { "$type": "color", "$value": "{color.primitive.canvas}" },
      "surface": { "$type": "color", "$value": "{color.primitive.white}" },
      "surfaceMuted": { "$type": "color", "$value": "{color.primitive.teal050}" },
      "neutralSurface": { "$type": "color", "$value": "{color.primitive.stone100}" },
      "surfaceContainerHigh": { "$type": "color", "$value": "{color.primitive.teal100}" },
      "surfaceContainerHighest": { "$type": "color", "$value": "{color.primitive.teal100}" },
      "textPrimary": { "$type": "color", "$value": "{color.primitive.teal900}" },
      "textSecondary": { "$type": "color", "$value": "{color.primitive.stone700}" },
      "border": { "$type": "color", "$value": "{color.primitive.stone200}" },
      "borderStrong": { "$type": "color", "$value": "{color.primitive.stone500}" },
      "outline": { "$type": "color", "$value": "{color.primitive.stone700}" },
      "primary": { "$type": "color", "$value": "{color.primitive.teal600}" },
      "primaryPressed": { "$type": "color", "$value": "{color.primitive.teal700}" },
      "primarySoft": { "$type": "color", "$value": "{color.primitive.teal100}" },
      "primaryInk": { "$type": "color", "$value": "{color.primitive.teal700}" },
      "onPrimary": { "$type": "color", "$value": "{color.primitive.white}" },
      "accent": { "$type": "color", "$value": "{color.primitive.orange500}" },
      "accentInk": { "$type": "color", "$value": "{color.primitive.orangeInk}" },
      "focus": { "$type": "color", "$value": "{color.primitive.orange500}" },
      "focusRing": { "$type": "color", "$value": "{color.primitive.teal700}" },
      "warningSurface": { "$type": "color", "$value": "{color.primitive.orange100}" },
      "warningText": { "$type": "color", "$value": "{color.primitive.orangeInk}" },
      "errorSurface": { "$type": "color", "$value": "{color.primitive.coral100}" },
      "errorText": { "$type": "color", "$value": "{color.primitive.coral700}" },
      "successSurface": { "$type": "color", "$value": "{color.primitive.green100}" },
      "successText": { "$type": "color", "$value": "{color.primitive.green700}" },
      "infoSurface": { "$type": "color", "$value": "{color.primitive.blue100}" },
      "infoText": { "$type": "color", "$value": "{color.primitive.blue700}" },
      "markRing": { "$type": "color", "$value": "{color.primitive.teal600}" },
      "markRoad": { "$type": "color", "$value": "{color.primitive.teal900}" }
    },
    "dark": {
      "background": { "$type": "color", "$value": "#06131C" },
      "surface": { "$type": "color", "$value": "#0C1F2B" },
      "surfaceMuted": { "$type": "color", "$value": "#12293A" },
      "neutralSurface": { "$type": "color", "$value": "#12293A" },
      "surfaceContainerHigh": { "$type": "color", "$value": "#183447" },
      "surfaceContainerHighest": { "$type": "color", "$value": "#1E3E53" },
      "textPrimary": { "$type": "color", "$value": "#F2F7FA" },
      "textSecondary": { "$type": "color", "$value": "#B3C6D3" },
      "border": { "$type": "color", "$value": "#2A4557" },
      "borderStrong": { "$type": "color", "$value": "#6A8497" },
      "outline": { "$type": "color", "$value": "#8FA7B8" },
      "primary": { "$type": "color", "$value": "#7CC4E8" },
      "primaryPressed": { "$type": "color", "$value": "#A9D8EF" },
      "primarySoft": { "$type": "color", "$value": "#123A52" },
      "primaryInk": { "$type": "color", "$value": "#BEE3F5" },
      "onPrimary": { "$type": "color", "$value": "#04202E" },
      "accent": { "$type": "color", "$value": "#FF9F2E" },
      "accentInk": { "$type": "color", "$value": "#4A2800" },
      "focus": { "$type": "color", "$value": "#FF9F2E" },
      "focusRing": { "$type": "color", "$value": "#FFD08F" },
      "warningSurface": { "$type": "color", "$value": "#4A3312" },
      "warningText": { "$type": "color", "$value": "#FFD9A3" },
      "errorSurface": { "$type": "color", "$value": "#47231F" },
      "errorText": { "$type": "color", "$value": "#FFB4AA" },
      "successSurface": { "$type": "color", "$value": "#173C29" },
      "successText": { "$type": "color", "$value": "#9DDFB5" },
      "infoSurface": { "$type": "color", "$value": "#19354F" },
      "infoText": { "$type": "color", "$value": "#A7D2FF" },
      "markRing": { "$type": "color", "$value": "#FFFFFF" },
      "markRoad": { "$type": "color", "$value": "#FFFFFF" }
    }
  },
  "space": {
    "0": { "$type": "dimension", "$value": "0px" },
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" }
  },
  "radius": {
    "small": { "$type": "dimension", "$value": "8px" },
    "medium": { "$type": "dimension", "$value": "12px" },
    "large": { "$type": "dimension", "$value": "18px" },
    "panel": { "$type": "dimension", "$value": "24px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "size": {
    "touchMinimum": { "$type": "dimension", "$value": "44px" },
    "control": { "$type": "dimension", "$value": "52px" },
    "iconSmall": { "$type": "dimension", "$value": "16px" },
    "icon": { "$type": "dimension", "$value": "24px" },
    "iconLarge": { "$type": "dimension", "$value": "32px" },
    "contentMaximum": { "$type": "dimension", "$value": "1200px" }
  },
  "typography": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": "Inter, SF Pro Text, Roboto, system-ui, sans-serif"
      },
      "mono": {
        "$type": "fontFamily",
        "$value": "SFMono-Regular, Roboto Mono, monospace"
      }
    },
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.family.sans}",
        "fontSize": "40px",
        "fontWeight": 720,
        "letterSpacing": "-0.8px",
        "lineHeight": 1.1
      }
    },
    "title": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.family.sans}",
        "fontSize": "28px",
        "fontWeight": 700,
        "letterSpacing": "-0.4px",
        "lineHeight": 1.2
      }
    },
    "heading": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.family.sans}",
        "fontSize": "20px",
        "fontWeight": 680,
        "letterSpacing": "-0.2px",
        "lineHeight": 1.3
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.family.sans}",
        "fontSize": "16px",
        "fontWeight": 450,
        "letterSpacing": "0px",
        "lineHeight": 1.5
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.family.sans}",
        "fontSize": "14px",
        "fontWeight": 650,
        "letterSpacing": "0.1px",
        "lineHeight": 1.3
      }
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.family.sans}",
        "fontSize": "12px",
        "fontWeight": 520,
        "letterSpacing": "0.2px",
        "lineHeight": 1.35
      }
    }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": "120ms" },
    "standard": { "$type": "duration", "$value": "220ms" },
    "slow": { "$type": "duration", "$value": "360ms" },
    "easing": {
      "$type": "cubicBezier",
      "$value": [
        0.2,
        0.8,
        0.2,
        1
      ]
    }
  },
  "shadow": {
    "card": {
      "$type": "shadow",
      "$value": {
        "color": "#082F4514",
        "offsetX": "0px",
        "offsetY": "6px",
        "blur": "18px",
        "spread": "0px"
      }
    },
    "floating": {
      "$type": "shadow",
      "$value": {
        "color": "#082F4524",
        "offsetX": "0px",
        "offsetY": "12px",
        "blur": "32px",
        "spread": "0px"
      }
    }
  }
}
