    "glassBlurRegular": {
      "$type": "dimension",
      "$value": "24px"
    },
    "glassBlurClear": {
      "$type": "dimension",
      "$value": "12px"
    },
    "glassSaturate": {
      "$type": "number",
      "$value": 1.4
    },
    "glassOpacityRegular": {
      "$type": "number",
      "$value": 0.72
    },
    "glassOpacityClear": {
      "$type": "number",
      "$value": 0.28
