    "fast": {
      "$type": "duration",
      "$value": "120ms"
    },
    "standard": {
      "$type": "duration",
      "$value": "220ms"
    },
    "slow": {
      "$type": "duration",
      "$value": "360ms"
    },
    "easing": {
      "$type": "cubicBezier",
      "$value": [
        0.2,
        0.8,
        0.2,
        1
      ]
    }
  },
  "shadow": {
    "card": {
      "$type": "shadow",
      "$value": {
        "color": "#082F4514",
        "offsetX": "0px",
        "offsetY": "6px",
        "blur": "18px",
        "spread": "0px"
      }
    },
    "floating": {
      "$type": "shadow",
      "$value": {
        "color": "#082F4524",
        "offsetX": "0px",
        "offsetY": "12px",
        "blur": "32px",
        "spread": "0px"
      }
    }
  },
